<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.som.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_whatsapp_channel"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp"
                        groups="mail_gateway.gateway_user"
                        attrs="{'invisible': [('whatsapp_channel_count', '=', 0)]}">
                    <field name="whatsapp_channel_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
